# Template for .env — copy to .env and fill in. .env is gitignored; this file is not.
# Never put a real key in this file.

# Text-to-speech for narrated videos (/explainer). Get it from your Speechify account.
SPEECHIFY_API_KEY=

# Optional: FRED series download without the keyless CSV endpoint (/lab-data).
FRED_API_KEY=
